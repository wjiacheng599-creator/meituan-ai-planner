#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# 1. 运行 TypeScript 类型检查
echo "📦 TypeScript type check..."
npm run type-check
if [ $? -ne 0 ]; then
  echo "❌ TypeScript type check failed"
  exit 1
fi

# 2. 运行 ESLint
echo "🔧 ESLint check..."
npm run lint:strict
if [ $? -ne 0 ]; then
  echo "❌ ESLint check failed"
  exit 1
fi

# 3. 运行 Prettier 检查
echo "💅 Prettier check..."
npm run format:check
if [ $? -ne 0 ]; then
  echo "❌ Prettier check failed"
  echo "Run 'npm run format' to fix formatting"
  exit 1
fi

# 4. 运行相关测试（只运行修改文件的测试）
echo "🧪 Running tests..."
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | grep -v '\.test\.' | grep -v '\.spec\.')

if [ -n "$CHANGED_FILES" ]; then
  # 为每个修改的文件运行对应的测试
  for file in $CHANGED_FILES; do
    # 将源文件路径转换为测试文件路径
    test_file=$(echo "$file" | sed 's|src/|src/__tests__/|' | sed 's|\.tsx$|.test.tsx|' | sed 's|\.ts$|.test.ts|')
    
    # 检查测试文件是否存在
    if [ -f "$test_file" ]; then
      echo "Running tests for: $test_file"
      npm test -- "$test_file" --passWithNoTests
      if [ $? -ne 0 ]; then
        echo "❌ Tests failed for: $test_file"
        exit 1
      fi
    fi
  done
else
  echo "No source files changed, skipping tests"
fi

echo "✅ All pre-commit checks passed!"
