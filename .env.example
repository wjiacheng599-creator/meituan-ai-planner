# AI Provider Configuration
# 可选值: dashscope (默认/主力), longcat (备用)
VITE_AI_PROVIDER=dashscope
DASHSCOPE_API_KEY=your_dashscope_api_key
LONGCAT_API_KEY=your_longcat_api_key

# Agent Execution Mode
# Set VITE_USE_REAL_AGENT=true to enable real AI agent with thinking (slower but more intelligent)
# Set VITE_DEMO_MODE_FAST=false to disable fast mock execution (enables real AI by default)
VITE_USE_REAL_AGENT=false
VITE_DEMO_MODE_FAST=true

# Map Configuration - 高德地图 API Key
# Web服务 API Key（用于后端POI搜索、路线规划等）
AMAP_KEY=your_web_service_key

# JS API Key（用于前端地图展示）
VITE_AMAP_KEY=your_js_api_key
VITE_AMAP_JS_KEY=your_js_api_key

# 安全密钥（用于JS API的安全验证，开发环境使用）
VITE_AMAP_SECURITY_CODE=your_security_code

# 生产环境代理地址（用于JS API安全验证，优先级高于 SECURITY_CODE）
# 配置后 JS API 请求将通过此代理转发，避免安全密钥泄露
# VITE_AMAP_SERVICE_HOST=https://your-domain.com/_AMapService

# Server Configuration
PORT=3000
COOKIE_SECRET=your_random_secret
FRONTEND_ORIGIN=http://localhost:5173
# 多个前端域名用逗号分隔，例如:
# CORS_ORIGINS=https://your-app.vercel.app,https://your-preview.vercel.app

# API Configuration
VITE_API_BASE_URL=http://localhost:3000

# Amap Proxy Settings
VITE_AMAP_USE_PROXY=true
VITE_AMAP_PROXY_HOST=/api/amap
